# انسخ هذه المتغيرات إلى Netlify: Site configuration > Environment variables
# لا يوجد رمز وصول. المطلوب مفتاح مزوّد واحد فقط:
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# حدود حماية الرصيد (اختيارية)
ADVISOR_DAILY_LIMIT=20
REFRESH_DAILY_LIMIT=8
